// Firestore Security Rules
//
// Bu dosya, Firebase Console > Firestore Database > Rules sekmesinde
// uygulanan kuralların kopyasıdır. Console'daki kurallar değiştirilirse
// bu dosya da güncellenmelidir (tek doğru kaynak).
//
// Deploy: Firebase CLI ile `firebase deploy --only firestore:rules`
// veya Console'a manuel kopyala-yapıştır.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Her kullanıcı sadece kendi profil dokümanına okuyabilir/yazabilir
    match /users/{userId} {
      // Sahip-bazlı erişim. (Not: alan-allowlist'i mevcut kullanıcıların eski
      // alanlı dokümanlarını kırma riski taşıdığı için Faz 4'e ertelendi; yetki/
      // abonelik alanları zaten AYRI, istemciye-kapalı bir koleksiyonda tutulacak.)
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;
    }

    // AI kullanım kotası — YALNIZCA sunucu (Admin SDK) erişir; istemci asla okuyamaz/yazamaz.
    // (Kullanıcı kendi kotasını sıfırlayamasın diye users/ dışında, ayrı koleksiyonda tutulur.)
    match /usage/{userId} {
      allow read, write: if false;
    }

    // Diğer her şey kapalı (ileride başka koleksiyon eklersek burayı güncelleriz)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
